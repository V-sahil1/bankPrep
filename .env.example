# Copy to .env and fill in. Never commit .env.
DATABASE_URL="postgresql://bankprep:bankprep@localhost:5433/bankprep"
# Generate with: npx auth secret  (or any 32+ random bytes, base64)
AUTH_SECRET=""
AUTH_TRUST_HOST=true
# Calendar day used for streaks and daily targets.
APP_TIMEZONE="Asia/Kolkata"
# Accounts created by `npm run db:seed`. The seed refuses to run without passwords.
SEED_ADMIN_EMAIL="admin@bankprep.local"
SEED_ADMIN_PASSWORD=""
SEED_DEMO_EMAIL="demo@bankprep.local"
SEED_DEMO_PASSWORD=""
# Optional. Without a key, AI generation is disabled and everything else works.
GEMINI_API_KEY=""
AI_MODEL="gemini-2.5-flash"
